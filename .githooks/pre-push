#!/bin/sh
# Pre-push hook — blocks a push if any check fails:
#   - tests/check-vercel-config.cjs   (vercel.json buildCommand must have a matching outputDirectory)
#   - tests/lint-gym-html.cjs         (top-level-TDZ lint, gym.html/plan.html/main.html/sync.js)
#   - tests/smoke-refresh-buttons.cjs (real-page click-through smoke test, gym.html)
#   - tests/smoke-main-todo.cjs       (real-page click-through smoke test, main.html's To Do list)
#   - tests/smoke-weekly-plan-card.cjs (real-page render check, gym.html's weekly objectives card)
#   - tests/smoke-fresh-week-rebalance.cjs (real-page rebalancer check, gym.html's rest-of-week + Today's session)
#   - tests/smoke-rhythm-split.cjs    (km-aware weekly-rhythm run/bike split, api/training.js)
#   - tests/smoke-today-rhythm-backstop.cjs (Today's/Tomorrow's session never invents an unscheduled session when a rhythm exists)
#   - tests/smoke-rhythm-cap-preview.cjs (weekly-rhythm long-run cap settings + "Next weeks" preview table, main.html)
#   - tests/smoke-build-stamp.cjs (footer build stamp on gym.html/main.html/plan.html)
#   - tests/smoke-availability-rhythm-allowed.cjs (a weekly-rhythm placement always counts as allowed on its own day, regardless of the availability template)
#   - tests/smoke-rebalance-backlog-named.cjs (backlog = capped by ahead-vs-remaining-target, always named; no generic "could not be placed"/"0 of 1" lines)
#   - tests/smoke-rhythm-cap-golden.cjs (server/client long-run-cap cross-check across 31 weeks + golden sequence + preview header)
#   - tests/smoke-fueling.cjs (Fueling card — computeFueling golden cases, real page render, settings sanitizer)
#   - tests/smoke-strength-core-extra.cjs (strength core-vs-optional-extra rebalance priority — classifyWeeklyStrengthRhythm, buildRebalanceLayout's STRENGTH block, todayStrengthDisplacement)
#   - tests/smoke-activity-kind.cjs (optional run/swim activity `kind` tagging — sanitizeActivityKind, computeClaimedKindSlots, suggestActivityKindForLog, the layout strike-through)
#   - tests/smoke-today-card-staleness.cjs (Today's session card staleness — computeTodayCardSignature, isLayoutDayFullyDone, "Outdated" note, "Done for today")
#   - tests/smoke-unplaced-backlog.cjs (a past-day session unplaced at generation time still becomes backlog — pastRhythmSessions/computeOutstandingByDiscipline, buildFinalLayout's enriched plan.unplaced)
#   - tests/smoke-rebalance-same-discipline.cjs (the rebalancer never places two sessions of the SAME discipline on one day — buildRebalanceLayout's dayAlreadyHasDiscipline/dayHasLoggedActivity)
#
# Installed via `git config core.hooksPath .githooks` — see this
# repo's package.json "prepare" script (runs automatically on
# `npm install`) or README for the one-line manual install step.
# Runs unconditionally on every push, regardless of which files
# changed — all checks finish in well under a minute, and scoping
# this to "did gym.html/plan.html/main.html/sync.js change in this
# push" adds a diff edge case for no real savings.

set -e
cd "$(git rev-parse --show-toplevel)"

if [ ! -d node_modules/jsdom ] || [ ! -d node_modules/eslint ]; then
  echo ""
  echo "pre-push: node_modules/jsdom or node_modules/eslint is missing."
  echo "pre-push: run \`npm install\` first, then push again."
  echo ""
  exit 1
fi

echo "pre-push: running tests/check-vercel-config.cjs ..."
if ! node tests/check-vercel-config.cjs; then
  echo ""
  echo "pre-push: BLOCKED — tests/check-vercel-config.cjs failed (see output above)."
  echo "pre-push: fix the reported issue(s), or run it by hand to iterate:"
  echo "pre-push:   node tests/check-vercel-config.cjs"
  echo ""
  exit 1
fi

echo ""
